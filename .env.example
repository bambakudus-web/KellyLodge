# Copy this file to .env and fill in your real values.
# On Railway, you'll set these as variables in your project settings instead.

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=kellylodge
DB_PORT=3306

PORT=3000
SESSION_SECRET=change_this_to_a_random_string

# Brevo transactional email — used to notify a hoster when their room gets booked.
# Get an API key from https://app.brevo.com/settings/keys/api
# SENDER_EMAIL must be a verified sender in your Brevo account.
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@kellylodge.com
BREVO_SENDER_NAME=KellyLodge

# Base URL used in verification email links (no trailing slash)
APP_URL=http://localhost:3000
