# Copy this file to .env and fill in your real values.
# On Railway, you'll set these as variables in your project settings instead.

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=kellylodge
DB_PORT=3306

PORT=3000
SESSION_SECRET=change_this_to_a_random_string

# Brevo transactional email — used to notify a hoster when their room gets booked.
# Get an API key from https://app.brevo.com/settings/keys/api
# SENDER_EMAIL must be a verified sender in your Brevo account.
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@kellylodge.com
BREVO_SENDER_NAME=KellyLodge

# Base URL used in verification email links, and Paystack's callback redirect (no trailing slash)
APP_URL=http://localhost:3000

# Arkesel SMS — used to notify students and hosters about bookings and payments by text.
# Get an API key from https://sms.arkesel.com (Account > API). ARKESEL_SENDER_ID must be
# a sender name registered and approved in your Arkesel account.
ARKESEL_API_KEY=your_arkesel_api_key_here
ARKESEL_SENDER_ID=KellyLodge

# Paystack — used to collect the year's rent within 72 hours of a booking.
# Get keys from https://dashboard.paystack.com/#/settings/developer
# PAYSTACK_SECRET_KEY is also used to verify that webhook calls really came from Paystack.
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Cloudinary — hostel listing photos are uploaded straight here instead of
# local disk, so nothing is lost when Railway redeploys (its filesystem
# doesn't persist between deploys). Get these from
# https://console.cloudinary.com/console (Dashboard tab, "Product Environment Credentials").
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# The platform's cut of each booking payment (percentage). The rest pays out
# automatically to the hoster's own bank account via Paystack Subaccounts,
# once they've set up payouts. Defaults to 10 if not set.
PLATFORM_FEE_PERCENT=10
